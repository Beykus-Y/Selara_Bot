# Telegram
BOT_TOKEN=__PUT_TELEGRAM_BOT_TOKEN_HERE__
BOT_NAME=Selara

# App
APP_ENV=dev
LOG_LEVEL=INFO
BOT_TIMEZONE=UTC

# DB
DATABASE_URL=postgresql+asyncpg://selara:__GENERATE_A_DATABASE_PASSWORD__@localhost:5432/selara
SELARA_DATABASE_URL=postgresql+asyncpg://selara:__GENERATE_A_DATABASE_PASSWORD__@postgres:5432/selara
SELARA_POSTGRES_DB=selara
SELARA_POSTGRES_USER=selara
SELARA_POSTGRES_PASSWORD=__GENERATE_A_DATABASE_PASSWORD__
ERROR_ALERT_CHAT_ID=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
REDIS_URL=redis://localhost:6379/0
GAME_STATE_TTL_HOURS=24

# Remote gacha API
GACHA_BASE_URL=
GACHA_GENSHIN_BASE_URL=
GACHA_HSR_BASE_URL=
GACHA_TIMEOUT_SECONDS=10
GACHA_ADMIN_USER_ID=
GACHA_ADMIN_TOKEN=
GACHA_SERVICE_TOKEN=__GENERATE_A_LONG_RANDOM_SECRET__
GACHA_REEL_CACHE_DIR=var/gacha_reel_cache

# Commands
# These are global defaults. Each group can override them via /setcfg.
TOP_LIMIT_DEFAULT=10
TOP_LIMIT_MAX=50
VOTE_DAILY_LIMIT=20
LEADERBOARD_HYBRID_KARMA_WEIGHT=0.7
LEADERBOARD_HYBRID_ACTIVITY_WEIGHT=0.3
LEADERBOARD_7D_DAYS=7
LEADERBOARD_WEEK_START_WEEKDAY=0
LEADERBOARD_WEEK_START_HOUR=0
MAFIA_NIGHT_SECONDS=90
MAFIA_DAY_SECONDS=120
MAFIA_VOTE_SECONDS=60
MAFIA_REVEAL_ELIMINATED_ROLE=true
TEXT_COMMANDS_ENABLED=true
TEXT_COMMANDS_LOCALE=ru
ACTIONS_18_ENABLED=true
SMART_TRIGGERS_ENABLED=true
WELCOME_ENABLED=true
WELCOME_TEXT=Привет, {user}! Добро пожаловать в {chat}.
WELCOME_BUTTON_TEXT=
WELCOME_BUTTON_URL=
GOODBYE_ENABLED=false
GOODBYE_TEXT=Пока, {user}.
WELCOME_CLEANUP_SERVICE_MESSAGES=true
CLEANUP_LEAVE_SERVICE_MESSAGES=false
ENTRY_CAPTCHA_ENABLED=false
ENTRY_CAPTCHA_TIMEOUT_SECONDS=180
ENTRY_CAPTCHA_KICK_ON_FAIL=true
CUSTOM_RP_ENABLED=true
FAMILY_TREE_ENABLED=true
TITLES_ENABLED=true
TITLE_PRICE=50000
CRAFT_ENABLED=true
AUCTIONS_ENABLED=true
AUCTION_DURATION_MINUTES=10
AUCTION_MIN_INCREMENT=100
ECONOMY_ENABLED=true
ECONOMY_MODE=global
ECONOMY_TAP_COOLDOWN_SECONDS=45
ECONOMY_DAILY_BASE_REWARD=120
ECONOMY_DAILY_STREAK_CAP=7
ECONOMY_LOTTERY_TICKET_PRICE=150
ECONOMY_LOTTERY_PAID_DAILY_LIMIT=10
ECONOMY_TRANSFER_DAILY_LIMIT=5000
ECONOMY_TRANSFER_TAX_PERCENT=5
ECONOMY_MARKET_FEE_PERCENT=2
ECONOMY_NEGATIVE_EVENT_CHANCE_PERCENT=22
ECONOMY_NEGATIVE_EVENT_LOSS_PERCENT=30
CLEANUP_ECONOMY_COMMANDS=false

# Web panel
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Public web domain: example.com or https://example.com
WEB_DOMAIN=
WEB_BASE_URL=http://127.0.0.1:8080
WEB_AUTH_SECRET=__GENERATE_A_LONG_RANDOM_SECRET__
WEB_LOGIN_CODE_TTL_MINUTES=5
WEB_SESSION_TTL_HOURS=168
WEB_SESSION_COOKIE_NAME=selara_session
WEB_SESSION_COOKIE_SECURE=false
WEB_LOGIN_ATTEMPT_LIMIT=8
WEB_LOGIN_ATTEMPT_WINDOW_MINUTES=5

# STT (Speech-to-Text) — Whisper-совместимый API (OpenAI, Groq, etc.)
# Groq бесплатно: https://console.groq.com → API Keys
# OpenAI: https://platform.openai.com → API Keys
STT_ENABLED=false
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3
STT_LANGUAGE=ru
STT_TIMEOUT_SECONDS=30
# Очередь распознавания голосовых/кружков для "Итогов дня" (отдельно от мгновенного
# ответа пользователю выше)
DAILY_SUMMARY_STT_CONCURRENCY=2
DAILY_SUMMARY_MAX_TRANSCRIPTION_SECONDS_PER_CHAT_PER_DAY=1800

# Admin panel
ADMIN_PASSWORD=__GENERATE_A_LONG_RANDOM_PASSWORD__
ADMIN_USER_ID=
# Set an owner-approved positive integer before enabling checkout. Unset means disabled.
# SELARA_AI_PRICE_STARS=<price in Stars>
# Selara Personal (per-user subscription). Unset means the product is hidden from /premium.
# SELARA_PERSONAL_PRICE_STARS=<price in Stars>
# Selara Personal: базовые срок и лимиты (default в config.py). Переопределяются в БД
# через Mini App API /monetization/personal-config без перезапуска; значение из БД главнее.
# SELARA_PERSONAL_DURATION_DAYS=30
# PERSONAL_FREE_DAILY_LIMIT=5
# PERSONAL_PAID_DAILY_LIMIT=150
# Личная память: лимиты числа фактов (free <= paid) и авто-извлечение фактов (по умолчанию выключено;
# работает только для Selara Personal и если пользователь включил его в /ai). Переопределяются в БД
# через /monetization/personal-config; значение из БД главнее.
# PERSONAL_MEMORY_FREE_LIMIT=20
# PERSONAL_MEMORY_PAID_LIMIT=200
# PERSONAL_MEMORY_AUTO_EXTRACT=false
# PERSONAL_MEMORY_EXTRACT_EVERY=10  # 2-40
ADMIN_SESSION_COOKIE_SECURE=false

# LLM Admin Assistant — AI-ассистент для администраторов
# Включить глобально (per-chat включается через /setcfg llm_enabled true)
LLM_ENABLED=false
# API-ключ: OpenAI → https://platform.openai.com/api-keys
#           Anthropic → https://console.anthropic.com/settings/api-keys
LLM_API_KEY=
# Base URL провайдера (OpenAI-совместимый формат)
# OpenAI:    https://api.openai.com/v1  (по умолчанию)
# Anthropic: https://api.anthropic.com/v1
# Groq:      https://api.groq.com/openai/v1
LLM_BASE_URL=
# Основная модель (для запросов с инструментами)
LLM_MODEL=gpt-4o-mini
# Модель для сжатия контекста (можно дешевле)
LLM_SUMMARY_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
# true только если провайдер/summary-модель реально поддерживают
# response_format={"type": "json_schema", ...} (не все OpenAI-совместимые API это
# умеют одинаково) -- используется структурированными стадиями сводки дня
LLM_SUPPORTS_STRUCTURED_OUTPUT=false
