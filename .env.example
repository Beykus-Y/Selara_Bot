# Telegram
BOT_TOKEN=__PUT_TELEGRAM_BOT_TOKEN_HERE__
BOT_NAME=Selara

# App
APP_ENV=dev
LOG_LEVEL=INFO
BOT_TIMEZONE=UTC

# DB
DATABASE_URL=postgresql+asyncpg://selara:__GENERATE_A_DATABASE_PASSWORD__@localhost:5432/selara
SELARA_DATABASE_URL=postgresql+asyncpg://selara:__GENERATE_A_DATABASE_PASSWORD__@postgres:5432/selara
SELARA_POSTGRES_DB=selara
SELARA_POSTGRES_USER=selara
SELARA_POSTGRES_PASSWORD=__GENERATE_A_DATABASE_PASSWORD__
ERROR_ALERT_CHAT_ID=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
REDIS_URL=redis://localhost:6379/0
GAME_STATE_TTL_HOURS=24

# Remote gacha API
GACHA_BASE_URL=
GACHA_GENSHIN_BASE_URL=
GACHA_HSR_BASE_URL=
GACHA_TIMEOUT_SECONDS=10
GACHA_ADMIN_USER_ID=
GACHA_ADMIN_TOKEN=
GACHA_SERVICE_TOKEN=__GENERATE_A_LONG_RANDOM_SECRET__
GACHA_REEL_CACHE_DIR=var/gacha_reel_cache

# Daily backup (Telegram -> ADMIN_USER_ID)
# Each dump is restore-verified, then encrypted to BACKUP_ENCRYPTION_PUBLIC_KEY
# before anything is sent. Telegram receives only ciphertext parts and a plain
# manifest. Generate the pair offline with `scripts/backup_restore.py keygen`;
# keep the private key off the bot host. Without a key no backup is sent.
# A failed check or encryption withholds the whole backup and reports the reason in Telegram.
BACKUP_ENCRYPTION_PUBLIC_KEY=
# Bound for pg_dump and every verification step (offline pg_restore parse and the
# SQLite integrity_check); a timeout stops the child or interrupts the check and
# fails the backup.
BACKUP_TIMEOUT_SECONDS=300
# pg_dump / pg_restore must exist in PATH at runtime (Docker image ships
# `postgresql-client`; bare-metal installs need it installed separately).
BACKUP_PG_DUMP_PATH=pg_dump
BACKUP_PG_RESTORE_PATH=pg_restore
# Restore drill (off by default): before anything is encrypted, each dump is
# restored into a scratch database on this PostgreSQL server (created and
# dropped by the bot), its schema head and critical tables are checked, and a
# failure withholds the whole backup. Turn it on only after checking that the
# database role has CREATEDB and the database volume has free space about the
# size of the database. The compose superuser has CREATEDB.
BACKUP_RESTORE_DRILL_ENABLED=false
# Bound for each restore into a scratch database.
BACKUP_RESTORE_DRILL_TIMEOUT_SECONDS=1800

# Commands
# These are global defaults. Each group can override them via /setcfg.
TOP_LIMIT_DEFAULT=10
TOP_LIMIT_MAX=50
VOTE_DAILY_LIMIT=20
LEADERBOARD_HYBRID_KARMA_WEIGHT=0.7
LEADERBOARD_HYBRID_ACTIVITY_WEIGHT=0.3
LEADERBOARD_7D_DAYS=7
LEADERBOARD_WEEK_START_WEEKDAY=0
LEADERBOARD_WEEK_START_HOUR=0
MAFIA_NIGHT_SECONDS=90
MAFIA_DAY_SECONDS=120
MAFIA_VOTE_SECONDS=60
MAFIA_REVEAL_ELIMINATED_ROLE=true
TEXT_COMMANDS_ENABLED=true
TEXT_COMMANDS_LOCALE=ru
ACTIONS_18_ENABLED=true
SMART_TRIGGERS_ENABLED=true
WELCOME_ENABLED=true
WELCOME_TEXT=Привет, {user}! Добро пожаловать в {chat}.
WELCOME_BUTTON_TEXT=
WELCOME_BUTTON_URL=
GOODBYE_ENABLED=false
GOODBYE_TEXT=Пока, {user}.
WELCOME_CLEANUP_SERVICE_MESSAGES=true
CLEANUP_LEAVE_SERVICE_MESSAGES=false
ENTRY_CAPTCHA_ENABLED=false
ENTRY_CAPTCHA_TIMEOUT_SECONDS=180
ENTRY_CAPTCHA_KICK_ON_FAIL=true
CUSTOM_RP_ENABLED=true
FAMILY_TREE_ENABLED=true
TITLES_ENABLED=true
TITLE_PRICE=50000
CRAFT_ENABLED=true
AUCTIONS_ENABLED=true
AUCTION_DURATION_MINUTES=10
AUCTION_MIN_INCREMENT=100
ECONOMY_ENABLED=true
ECONOMY_MODE=global
ECONOMY_TAP_COOLDOWN_SECONDS=45
ECONOMY_DAILY_BASE_REWARD=120
ECONOMY_DAILY_STREAK_CAP=7
ECONOMY_LOTTERY_TICKET_PRICE=150
ECONOMY_LOTTERY_PAID_DAILY_LIMIT=10
ECONOMY_TRANSFER_DAILY_LIMIT=5000
ECONOMY_TRANSFER_TAX_PERCENT=5
ECONOMY_MARKET_FEE_PERCENT=2
ECONOMY_NEGATIVE_EVENT_CHANCE_PERCENT=22
ECONOMY_NEGATIVE_EVENT_LOSS_PERCENT=30
CLEANUP_ECONOMY_COMMANDS=false

# Web panel
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8080
# Trust only actual reverse proxies. Empty disables forwarded-header trust.
# Docker: use the dedicated proxy IP or its isolated subnet, never * or /0.
WEB_FORWARDED_ALLOW_IPS=127.0.0.1,::1
# Public web domain: example.com or https://example.com
WEB_DOMAIN=
WEB_BASE_URL=http://127.0.0.1:8080
# Required: startup fails without it (web panel is on by default).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Dev-only fallback to BOT_TOKEN exists but must be opted into explicitly
# (WEB_AUTH_ALLOW_BOT_TOKEN_FALLBACK=true) and is never the default.
WEB_AUTH_SECRET=
WEB_LOGIN_CODE_TTL_MINUTES=5
WEB_SESSION_TTL_HOURS=168
WEB_SESSION_COOKIE_NAME=selara_session
# Auto: true for HTTPS/public hosts, false for HTTP localhost/loopback.
# Explicit false is rejected for HTTPS. Optional HTTP development override:
# WEB_SESSION_COOKIE_SECURE=false
WEB_LOGIN_ATTEMPT_LIMIT=8
WEB_LOGIN_ATTEMPT_WINDOW_MINUTES=5

# STT (Speech-to-Text) — Whisper-совместимый API (OpenAI, Groq, etc.)
# Groq бесплатно: https://console.groq.com → API Keys
# OpenAI: https://platform.openai.com → API Keys
STT_ENABLED=false
STT_API_KEY=
STT_BASE_URL=https://api.groq.com/openai/v1
STT_MODEL=whisper-large-v3
STT_LANGUAGE=ru
STT_TIMEOUT_SECONDS=30
# Мгновенный STT использует общий Redis cooldown на (chat, user). При отказе Redis
# новые платные вызовы блокируются; 0 явно отключает cooldown.
STT_COOLDOWN_SECONDS=8
# Очередь распознавания голосовых/кружков для "Итогов дня" (отдельно от мгновенного
# ответа пользователю выше)
DAILY_SUMMARY_STT_CONCURRENCY=2
DAILY_SUMMARY_MAX_TRANSCRIPTION_SECONDS_PER_CHAT_PER_DAY=1800
# Message archive: rows older than N days (text, raw JSON, transcripts) and parked activity dead letters are
# deleted for good. 0 (default) keeps everything. N >= 7 turns the cleanup on: the first run comes about a minute
# after start, then hourly. Enabling it cannot be undone, so take a backup first. 1-6 are rejected.
# See docs/MESSAGE_ARCHIVE_RETENTION.md.
MESSAGE_ARCHIVE_RETENTION_DAYS=0
# Shutdown waits at most N seconds for the activity inbox to drain; the rest waits for the next start.
ACTIVITY_BATCH_CLOSE_GRACE_SECONDS=5

# Admin panel
ADMIN_PASSWORD=__GENERATE_A_LONG_RANDOM_PASSWORD__
ADMIN_USER_ID=
# Set an owner-approved positive integer before enabling checkout. Unset means disabled.
# SELARA_AI_PRICE_STARS=<price in Stars>
# Selara Personal (per-user subscription). Unset means the product is hidden from /premium.
# SELARA_PERSONAL_PRICE_STARS=<price in Stars>
# Selara Personal: базовые срок и лимиты (default в config.py). Переопределяются в БД
# через Mini App API /monetization/personal-config без перезапуска; значение из БД главнее.
# SELARA_PERSONAL_DURATION_DAYS=30
# PERSONAL_FREE_DAILY_LIMIT=5
# PERSONAL_PAID_DAILY_LIMIT=150
# Режим AIL: actual (по умолчанию) списывает реальную стоимость запроса / PERSONAL_AIL_USD_VALUE,
# множитель профиля тогда только резерв на старт; fixed списывает множитель профиля.
# PERSONAL_AIL_BILLING=actual
# PERSONAL_AIL_USD_VALUE=0.0005
# Реальная стоимость запроса от OpenRouter (usage.cost): по умолчанию включается сама для openrouter.ai.
# LLM_INCLUDE_USAGE_COST=
# Необязательные настройки маршрутизации OpenRouter (JSON-объект), например {"max_price": {"prompt": 0.5}}.
# Применяется только к личному чату Personal (не к группам, ?/??, питомцам).
# LLM_PROVIDER_PREFERENCES_JSON=
# Личная память: лимиты числа фактов (free <= paid) и авто-извлечение фактов (по умолчанию выключено;
# работает только для Selara Personal и если пользователь включил его в /ai). Переопределяются в БД
# через /monetization/personal-config; значение из БД главнее.
# PERSONAL_MEMORY_FREE_LIMIT=20
# PERSONAL_MEMORY_PAID_LIMIT=200
# PERSONAL_MEMORY_AUTO_EXTRACT=false
# PERSONAL_MEMORY_EXTRACT_EVERY=10  # 2-40
# Разговоры с AI-питомцем оплачивает Selara Personal хозяина: всего в день, доля всех гостей и одного гостя.
# PET_TALK_DAILY_LIMIT=60
# AI Limits mode: AIL reserved per pet model line (per-request cap); the line settles at its real cost
# PET_REQUEST_AIL_CAP=3
# Tools of the private assistant (/ai -> Tools; Selara Personal only, off by default per user)
# PERSONAL_TOOL_ROUNDS=6
# PERSONAL_WEB_MAX_CALLS=3
# PERSONAL_WEB_PAGE_CHARS=6000
# PERSONAL_TOOLS_RESERVE_FACTOR=3
# Custom pet actions (/pet_do): per person per day, for the owner and for everyone else
# PET_CUSTOM_ACTIONS_DAILY_LIMIT=10
# PET_CUSTOM_ACTIONS_GUEST_DAILY_LIMIT=5
# PET_CUSTOM_ACTIONS_GUESTS_DAILY_LIMIT=20
# PET_TALK_GUESTS_DAILY_LIMIT=20
# PET_TALK_GUEST_DAILY_LIMIT=5
# Спонтанные события питомцев (включаются в чате настройкой pets_spontaneous_enabled), из того же лимита хозяина.
# PET_EVENT_DAILY_LIMIT=6
# PET_EVENT_CHAT_INTERVAL_MINUTES=120
# PET_EVENT_QUIET_START_HOUR=23
# PET_EVENT_QUIET_END_HOUR=8
# PET_EVENT_CHECK_SECONDS=300
# PET_EVENT_CHANCE=0.3
# Обращение к Selara по кличке в группе (member-mode): бесплатно всем чатам, Selara AI расширяет лимиты.
# В сутки на чат и на одного участника.
# GROUP_MEMBER_FREE_DAILY_LIMIT=30
# GROUP_MEMBER_FREE_PER_USER_DAILY_LIMIT=5
# GROUP_MEMBER_PAID_DAILY_LIMIT=100
# GROUP_MEMBER_PAID_PER_USER_DAILY_LIMIT=30
# Ходы модели на один запрос «?»/«??» и по кличке (последний ход без инструментов): без подписки группы / с ней.
# GROUP_TOOL_ROUNDS_FREE=4
# GROUP_TOOL_ROUNDS_PAID=8
# Потолок ответа модели (токены): «?»/«??» и обращение по кличке.
# LLM_ADMIN_MAX_TOKENS=800
# GROUP_MEMBER_MAX_TOKENS=500
# Закрепить провайдера OpenRouter для «?»/«??» и клички (JSON-объект `provider`), например DeepSeek Flash без подмены:
# LLM_GROUP_PROVIDER_PREFERENCES_JSON={"order": ["DeepSeek"], "allow_fallbacks": false}
# Same automatic policy as WEB_SESSION_COOKIE_SECURE.
# ADMIN_SESSION_COOKIE_SECURE=false

# LLM Admin Assistant — AI-ассистент для администраторов
# Включить глобально (per-chat включается через /setcfg llm_enabled true)
LLM_ENABLED=false
# API-ключ: OpenAI → https://platform.openai.com/api-keys
#           Anthropic → https://console.anthropic.com/settings/api-keys
LLM_API_KEY=
# Base URL провайдера (OpenAI-совместимый формат)
# OpenAI:    https://api.openai.com/v1  (по умолчанию)
# Anthropic: https://api.anthropic.com/v1
# Groq:      https://api.groq.com/openai/v1
LLM_BASE_URL=
# Основная модель (для запросов с инструментами)
LLM_MODEL=gpt-4o-mini
# Модель для сжатия контекста (можно дешевле)
LLM_SUMMARY_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
# true только если провайдер/summary-модель реально поддерживают
# response_format={"type": "json_schema", ...} (не все OpenAI-совместимые API это
# умеют одинаково) -- используется структурированными стадиями сводки дня
LLM_SUPPORTS_STRUCTURED_OUTPUT=false

# Web search tools для AI-ассистента (web_search / fetch_page через ?/??)
# Доступны всем чатам, где включён ассистент; работают без API-ключа.
# DuckDuckGo заблокирован в РФ: серверу нужен прямой сетевой доступ к lite.duckduckgo.com (VPS вне РФ). HTTP(S)_PROXY игнорируются — при недоступности направьте поиск на свой шлюз через WEB_SEARCH_BASE_URL.
WEB_SEARCH_ENABLED=true
# auto (по умолчанию): SearXNG из docker-compose (сервис searxng), при его
# отсутствии/сбое — DuckDuckGo. Также: searxng, duckduckgo (часто 202/403 с
# датацентровых IP), tavily/brave (нужен WEB_SEARCH_API_KEY, fallback на duckduckgo).
WEB_SEARCH_PROVIDER=auto
WEB_SEARCH_SEARXNG_URL=http://searxng:8080
WEB_SEARCH_API_KEY=
# Шлюз ТОЛЬКО для DuckDuckGo; ключевые провайдеры его не используют
WEB_SEARCH_BASE_URL=
WEB_SEARCH_TIMEOUT_SECONDS=15
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MAX_PAGE_CHARS=8000
WEB_SEARCH_MAX_CALLS_PER_INVOCATION=4

# Секрет SearXNG (docker compose up -d searxng): openssl rand -hex 32
SELARA_SEARXNG_SECRET=
